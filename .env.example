# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.

# --- Welcome emails (Zoho Mail EU example) ---
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_USER=admin@yourdomain.com
SMTP_PASSWORD=your-app-password

# --- Owner / admin panel (/admin.html) ---
# Emails allowed to open the admin panel (comma separated) ...
ADMIN_EMAILS=you@example.com
# ... plus a long secret passphrase you type once to unlock admin powers
ADMIN_KEY=choose-a-long-random-passphrase

# --- Storage (only needed in production) ---
# Put these on a persistent disk so data survives restarts, e.g. /var/data on Render
# DB_PATH=/var/data/db.json
# UPLOADS_DIR=/var/data/uploads

# --- Website address used inside password-reset emails ---
# BASE_URL=https://www.globalrate.space

# --- Sign-in sessions (optional) ---
# Users stay signed in until idle this many days (sliding). Default 30.
# SESSION_IDLE_DAYS=30
# Admin powers lock again after this many idle minutes. Default 30.
# ADMIN_IDLE_MINUTES=30
